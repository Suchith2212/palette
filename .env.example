# Palette — combined example environment variables for deployment

#########################
# Backend (server/.env)
#########################
# MongoDB connection (use Railway plugin or Atlas). Example:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/palette?retryWrites=true&w=majority
MONGO_URI=

# Server
PORT=3000
NODE_ENV=production

# JWT secret (production only)
JWT_SECRET=

# CORS — comma-separated allowed origins for production (example: https://your-app.vercel.app)
CORS_ORIGIN=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Palette Art Club
EMAIL_FROM_EMAIL=palette@iitgn.ac.in

#########################
# Frontend (client/.env) — Vite variables must be prefixed with VITE_
#########################
# Production only — your Railway API URL (no trailing slash). Example:
# VITE_API_ORIGIN=https://palette-api-production.up.railway.app
VITE_API_ORIGIN=

#########################
# Notes
#########################
# - Never commit real secrets. Use Railway / Vercel UI to set secret values.
# - Locally, you can create `server/.env` and `client/.env` with the values you need.
# - If you use other services (Cloudinary, S3), add their keys here but keep them secret.
