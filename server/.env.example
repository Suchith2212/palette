# Database
# Local dev (requires MongoDB installed and running):
MONGO_URI=mongodb://127.0.0.1:27017/palette
#
# MongoDB Atlas (encode special chars in password, e.g. @ → %40):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/palette?retryWrites=true&w=majority

# Server
PORT=3000
NODE_ENV=development

# Auth — required in production (use a long random string)
JWT_SECRET=

# CORS — comma-separated allowed origins in production
# Example: https://palette.iitgn.ac.in,https://www.palette.iitgn.ac.in
CORS_ORIGIN=

# Email (SMTP) for verification and reminders
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=Palette Art Club
EMAIL_FROM_EMAIL=palette@iitgn.ac.in
